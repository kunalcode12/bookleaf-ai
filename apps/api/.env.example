# BookLeaf Support API — copy to apps/api/.env and fill in.
# Every value is validated at startup; the server refuses to boot with an invalid setting.
# Nothing here is ever sent to the browser. Never commit the filled-in .env.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Web origins allowed for CORS and cookie-authenticated writes (comma-separated).
APP_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Optional shared secret the web proxy sends as x-origin-secret; direct calls without it get 403.
ORIGIN_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# Zero-setup local mode: embedded Postgres (PGlite) on disk. Only one process can open it.
DATABASE_URL=pglite://./.data/pglite
# Supabase (Connect → Session pooler). Port 5432 keeps LISTEN/NOTIFY realtime and prepared
# statements; the transaction pooler (6543) supports neither. Render and most hosts need this form:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The direct host (db.<project-ref>.supabase.co) is IPv6-only — fine locally if your network has IPv6.
# Connections per process (plus 2 for jobs, 1 for realtime). The session pooler allows ~15 in total.
DATABASE_POOL_MAX=5
AUTO_MIGRATE=true
# Load the sample dataset + demo queue automatically when the database is empty.
AUTO_SEED=true

# ── Auth ──────────────────────────────────────────────────────────────────────
# local: embedded logins (development/tests only). supabase: Supabase Auth (required in production).
AUTH_PROVIDER=local
LOCAL_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Supabase → Project Settings → API Keys (publishable sb_publishable_…, secret sb_secret_…).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Leave blank on projects using JWT signing keys (the default; tokens are checked against JWKS).
# Only for projects still on the legacy shared HS256 secret.
SUPABASE_JWT_SECRET=
# auto = secure cookies when PUBLIC_APP_URL is https.
COOKIE_SECURE=auto

# ── Attachments ───────────────────────────────────────────────────────────────
# local: files on disk behind HMAC-signed links. supabase: a private Supabase Storage bucket
# (created on first start; uploads and downloads use short-lived signed URLs).
STORAGE_PROVIDER=local
STORAGE_BUCKET=ticket-attachments
# Used only with STORAGE_PROVIDER=local.
LOCAL_STORAGE_DIR=./.data/uploads
FILE_SIGNING_SECRET=change-me-to-another-long-random-string-32+

# ── Leaf (AI) ─────────────────────────────────────────────────────────────────
# Any subset works; with none, triage falls back to rules and drafts to policy outlines.
# Gemini: https://aistudio.google.com/apikey · Groq: https://console.groq.com/keys · OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Everything below is optional: blank uses the built-in routes, models and limits (see docs/AI.md).
# Route overrides, tried in order: provider:model[@reasoning], comma-separated. For example, to
# draft with Groq first when Gemini's free tier is congested:
# LEAF_ROUTE_DRAFT=groq:openai/gpt-oss-120b@low,gemini:gemini-3.6-flash@low,openrouter:openrouter/free
LEAF_ROUTE_TRIAGE=
LEAF_ROUTE_DRAFT=
LEAF_ROUTE_ASSIST=
LEAF_ROUTE_SUMMARIZE=
# provider:model swaps a model; "off" disables it. Embeddings power similar tickets, incident
# clusters and semantic knowledge matching (without them knowledge is matched by category); the
# guard model is the prompt-injection classifier (the heuristic scanner runs either way).
LEAF_EMBEDDING_MODEL=
LEAF_GUARD_MODEL=
# Client-side quota guards; each entry replaces that model's default. Take the numbers from
# AI Studio / the Groq console, e.g.
# LEAF_RATE_LIMITS=gemini:gemini-3.6-flash=rpm:8,rpd:20;groq:openai/gpt-oss-120b=rpm:28,rpd:950
LEAF_RATE_LIMITS=
# Domains Leaf may link to in replies (anything else is flagged).
LEAF_ALLOWED_LINK_DOMAINS=bookleaf.in
# true once providers bill this project (changes how cost is reported in Insights).
LEAF_PAID_TIER=false

# ── Email ─────────────────────────────────────────────────────────────────────
# Without a key, emails are written to the log instead of sent.
RESEND_API_KEY=
# Until a domain is verified in Resend, send from onboarding@resend.dev — Resend then delivers
# only to the Resend account's own address.
EMAIL_FROM=BookLeaf Author Support <onboarding@resend.dev>
# Demo/staging: deliver every email to this one address (e.g. the Resend account owner) instead
# of the recipient; the subject names who it was for.
EMAIL_REDIRECT_TO=

# ── Workers & demo ────────────────────────────────────────────────────────────
# inline: background jobs run inside the API process. off: run `pnpm --filter @bookleaf/api start:worker`.
WORKER_MODE=inline
# Shows the demo personas on the login page.
DEMO_MODE=true
SEED_AUTHOR_PASSWORD=BookLeaf@Author1
SEED_ADMIN_PASSWORD=BookLeaf@Admin1
