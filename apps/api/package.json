{
  "name": "@bookleaf/api",
  "version": "1.0.0",
  "private": true,
  "description": "BookLeaf Support REST API: auth, role-based access, tickets, realtime (SSE), background jobs and the Leaf AI orchestration.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:reset": "tsx src/cli/reset.ts",
    "openapi:export": "tsx src/cli/export-openapi.ts"
  },
  "dependencies": {
    "@bookleaf/ai": "workspace:*",
    "@bookleaf/contracts": "workspace:*",
    "@bookleaf/db": "workspace:*",
    "@bookleaf/domain": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-pgvector": "catalog:",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@scalar/fastify-api-reference": "1.76.0",
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.13",
    "lru-cache": "11.5.3",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "postgres": "catalog:",
    "resend": "6.34.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "openapi-to-postmanv2": "6.4.2",
    "openapi-types": "12.1.3",
    "pino-pretty": "13.2.0",
    "tsup": "9.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
