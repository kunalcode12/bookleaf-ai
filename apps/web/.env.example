# BookLeaf web app — copy to apps/web/.env.local.
# Server-only: never exposed to the browser (no NEXT_PUBLIC_ prefix).

# Where the API runs. The browser calls /api/* on this origin; src/proxy.ts forwards it here.
API_ORIGIN=http://localhost:4000
# Must match ORIGIN_SECRET on the API when that is set (the API then rejects direct calls).
API_ORIGIN_SECRET=

# Public link to the interactive API reference, shown in the admin desk footer.
NEXT_PUBLIC_API_DOCS_URL=http://localhost:4000/docs
